<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.layout.VBox?>

<TabPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
         fx:controller="co.edu.uniquidio.poo.proyecto_final.ViewController.AdminDashboardViewController"
         tabClosingPolicy="UNAVAILABLE" style="-fx-background-color: #f4f6f9;">

    <Tab text="👥 Usuarios">
        <TableView fx:id="tablaUsuarios" style="-fx-font-size: 14px;"/>
    </Tab>

    <Tab text="🎟️ Eventos">
        <TableView fx:id="tablaEventos" style="-fx-font-size: 14px;"/>
    </Tab>

    <Tab text="📊 Métricas">
        <VBox spacing="20" padding="20">
            <BarChart fx:id="chartVentas" title="Ventas por Evento" style="-fx-font-size: 14px;"/>
            <PieChart fx:id="chartOcupacion" title="Ocupación por Zona" style="-fx-font-size: 14px;"/>
        </VBox>
    </Tab>

    <Tab text="📄 Reportes">
        <VBox spacing="15" padding="30" alignment="CENTER">
            <Button text="📊 Generar Reporte CSV" onAction="#generarReporteCSV"
                    style="-fx-background-color: #43a047; -fx-text-fill: white; -fx-font-size: 16px; -fx-pref-width: 300;"/>
            <Button text="📑 Generar Reporte PDF" onAction="#generarReportePDF"
                    style="-fx-background-color: #1e88e5; -fx-text-fill: white; -fx-font-size: 16px; -fx-pref-width: 300;"/>
        </VBox>
    </Tab>
</TabPane>