<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.uniquidio.poo.proyecto_patrones.Controller.PerfilController"
      alignment="CENTER" spacing="15" padding="30" style="-fx-background-color: #f4f6f9;">

    <Label text="👤 Editar Perfil" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1e88e5;"/>

    <TextField fx:id="txtNombre" promptText="Nombre completo" prefWidth="350"/>
    <TextField fx:id="txtCorreo" promptText="Correo electrónico" prefWidth="350"/>
    <TextField fx:id="txtTelefono" promptText="Teléfono" prefWidth="350"/>

    <Button text="💾 Guardar Cambios" onAction="#guardarCambios"
            style="-fx-background-color: #43a047; -fx-text-fill: white; -fx-font-size: 16px; -fx-pref-width: 350;"/>

    <Label fx:id="lblMensaje" style="-fx-text-fill: #2e7d32; -fx-font-size: 14px;"/>
</VBox>