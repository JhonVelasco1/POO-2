<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.uniquidio.poo.proyecto_final.ViewController.SeleccionAsientosViewController"
      alignment="TOP_CENTER" spacing="12"
      style="-fx-background-color: #eceff1;">
    <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>

    <Label text="🪑  Selección de Asientos"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1565c0;"/>

    <!-- CORRECCIÓN: Selector de Evento (para que la compra quede bien vinculada) -->
    <HBox spacing="14" alignment="CENTER_LEFT"
          style="-fx-background-color: #fff9c4; -fx-background-radius: 10; -fx-padding: 12; -fx-border-color: #f9a825; -fx-border-radius: 10;">
        <Label text="🎤 Evento:" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
        <ComboBox fx:id="cmbEvento" prefWidth="300"
                  promptText="Selecciona el evento para reservar asientos"
                  style="-fx-background-radius: 6;"/>
        <Label text="← Selecciona el evento antes de confirmar" style="-fx-font-size: 11px; -fx-text-fill: #f57f17;"/>
    </HBox>

    <!-- Selector de zona + info -->
    <HBox spacing="14" alignment="CENTER_LEFT"
          style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 12;">
        <Label text="Zona:" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
        <ComboBox fx:id="cmbZona" prefWidth="160" style="-fx-background-radius: 6;"/>
        <Label fx:id="lblInfoZona" style="-fx-font-size: 12px; -fx-text-fill: #555;" wrapText="true"/>
    </HBox>

    <!-- Leyenda -->
    <HBox spacing="18" alignment="CENTER"
          style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 10;">
        <HBox spacing="6" alignment="CENTER">
            <Label text="  " style="-fx-background-color: #4caf50; -fx-background-radius: 4; -fx-min-width: 22; -fx-min-height: 18;"/>
            <Label text="Disponible" style="-fx-font-size: 12px;"/>
        </HBox>
        <HBox spacing="6" alignment="CENTER">
            <Label text="  " style="-fx-background-color: #1e88e5; -fx-background-radius: 4; -fx-min-width: 22; -fx-min-height: 18;"/>
            <Label text="Seleccionado" style="-fx-font-size: 12px;"/>
        </HBox>
        <HBox spacing="6" alignment="CENTER">
            <Label text="  " style="-fx-background-color: #e53935; -fx-background-radius: 4; -fx-min-width: 22; -fx-min-height: 18;"/>
            <Label text="Reservado" style="-fx-font-size: 12px;"/>
        </HBox>
        <HBox spacing="6" alignment="CENTER">
            <Label text="  " style="-fx-background-color: #9e9e9e; -fx-background-radius: 4; -fx-min-width: 22; -fx-min-height: 18;"/>
            <Label text="Bloqueado" style="-fx-font-size: 12px;"/>
        </HBox>
    </HBox>

    <!-- Escenario -->
    <Label text="▬▬▬▬▬▬▬▬▬▬  ESCENARIO  ▬▬▬▬▬▬▬▬▬▬"
           maxWidth="Infinity" alignment="CENTER"
           style="-fx-background-color: #1565c0; -fx-text-fill: white;
                  -fx-padding: 8 20 8 20; -fx-background-radius: 8;
                  -fx-font-weight: bold; -fx-font-size: 13px;"/>

    <!-- Mapa -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: white; -fx-background-radius: 10;">
        <VBox alignment="CENTER" style="-fx-padding: 16;">
            <GridPane fx:id="gridAsientos" hgap="4" vgap="4" alignment="CENTER"/>
        </VBox>
    </ScrollPane>

    <!-- Resumen y botones -->
    <HBox spacing="16" alignment="CENTER"
          style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 14;">
        <VBox spacing="4">
            <Label fx:id="lblSeleccionados"
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1565c0;"/>
            <Label fx:id="lblTotal"
                   style="-fx-font-size: 13px; -fx-text-fill: #2e7d32; -fx-font-weight: bold;"/>
        </VBox>
        <Separator orientation="VERTICAL"/>
        <HBox spacing="10">
            <Button text="🔄 Refrescar" onAction="#refrescarMapa"
                    style="-fx-background-color: #757575; -fx-text-fill: white;
                           -fx-background-radius: 8; -fx-padding: 8 16 8 16; -fx-cursor: hand;"/>
            <Button fx:id="btnConfirmar" text="✅ Confirmar Selección"
                    onAction="#confirmarSeleccion" disable="true"
                    style="-fx-background-color: #1565c0; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-background-radius: 8;
                           -fx-padding: 8 20 8 20; -fx-cursor: hand;"/>
        </HBox>
    </HBox>
</VBox>
