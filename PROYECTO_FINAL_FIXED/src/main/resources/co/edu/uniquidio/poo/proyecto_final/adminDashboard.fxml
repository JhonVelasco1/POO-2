<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uniquidio.poo.proyecto_final.ViewController.AdminDashboardViewController"
            style="-fx-background-color: #eceff1;">

    <!-- Barra superior con botón de cerrar sesión -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: #1565c0; -fx-padding: 14 20 14 20;">
            <Label text="⚙️  Panel de Administrador"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"
                   HBox.hgrow="ALWAYS"/>
            <!-- BOTÓN CERRAR SESIÓN -->
            <Button text="🚪 Cerrar Sesión" onAction="#cerrarSesion"
                    style="-fx-background-color: #c62828; -fx-text-fill: white; -fx-font-weight: bold;
                           -fx-background-radius: 6; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">

            <!-- TAB: USUARIOS -->
            <Tab text="👥  Usuarios">
                <VBox spacing="10">
                    <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                    <Label text="Gestión de Usuarios" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1565c0;"/>

                    <HBox spacing="10" alignment="CENTER_LEFT"
                          style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 14;">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Nombre" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                            <TextField fx:id="txtUNombre" promptText="Nombre completo" style="-fx-background-radius: 6;"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Correo" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                            <TextField fx:id="txtUCorreo" promptText="correo@ejemplo.com" style="-fx-background-radius: 6;"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Teléfono" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                            <TextField fx:id="txtUTelefono" promptText="Teléfono" style="-fx-background-radius: 6;"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Contraseña" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                            <PasswordField fx:id="txtUPassword" promptText="Contraseña" style="-fx-background-radius: 6;"/>
                        </VBox>
                        <VBox spacing="6" alignment="BOTTOM_LEFT">
                            <Button text="➕ Crear"      onAction="#crearUsuario"
                                    style="-fx-background-color: #43a047; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;"/>
                            <Button text="✏️ Actualizar" onAction="#actualizarUsuario"
                                    style="-fx-background-color: #1e88e5; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;"/>
                            <Button text="🗑️ Eliminar"   onAction="#eliminarUsuario"
                                    style="-fx-background-color: #e53935; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;"/>
                        </VBox>
                    </HBox>

                    <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colUId"       text="ID"       prefWidth="90"/>
                            <TableColumn fx:id="colUNombre"   text="Nombre"   prefWidth="180"/>
                            <TableColumn fx:id="colUCorreo"   text="Correo"   prefWidth="200"/>
                            <TableColumn fx:id="colUTelefono" text="Teléfono" prefWidth="120"/>
                        </columns>
                        <placeholder><Label text="No hay usuarios registrados"/></placeholder>
                    </TableView>
                </VBox>
            </Tab>

            <!-- TAB: EVENTOS -->
            <Tab text="🎟️  Eventos">
                <VBox spacing="10">
                    <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                    <Label text="Gestión de Eventos" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1565c0;"/>

                    <HBox spacing="10" alignment="CENTER_LEFT"
                          style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 14;">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Tipo" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                            <ComboBox fx:id="cmbETipo" prefWidth="130"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Nombre del Evento" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                            <TextField fx:id="txtENombre" promptText="Nombre del evento" style="-fx-background-radius: 6;"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Ciudad" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                            <TextField fx:id="txtECiudad" promptText="Ciudad" style="-fx-background-radius: 6;"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Fecha/Hora (yyyy-MM-dd HH:mm)" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                            <TextField fx:id="txtEFecha" promptText="2026-06-15 20:00" style="-fx-background-radius: 6;"/>
                        </VBox>
                        <VBox spacing="4" alignment="BOTTOM_LEFT">
                            <HBox spacing="6">
                                <Button text="➕ Crear"      onAction="#crearEvento"
                                        style="-fx-background-color: #43a047; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;"/>
                                <!-- BOTÓN ACTUALIZAR EVENTO que faltaba -->
                                <Button text="✏️ Actualizar" onAction="#actualizarEvento"
                                        style="-fx-background-color: #1e88e5; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;"/>
                            </HBox>
                            <HBox spacing="6">
                                <Button text="✅ Publicar"   onAction="#publicarEvento"
                                        style="-fx-background-color: #7b1fa2; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;"/>
                                <Button text="⏸ Cancelar"   onAction="#cancelarEvento"
                                        style="-fx-background-color: #fb8c00; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;"/>
                            </HBox>
                            <Button text="🗑️ Eliminar"       onAction="#eliminarEvento"
                                    style="-fx-background-color: #e53935; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>

                    <TableView fx:id="tablaEventos" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colEId"     text="ID"         prefWidth="80"/>
                            <TableColumn fx:id="colENombre" text="Nombre"     prefWidth="200"/>
                            <TableColumn fx:id="colECiudad" text="Ciudad"     prefWidth="110"/>
                            <TableColumn fx:id="colEFecha"  text="Fecha/Hora" prefWidth="140"/>
                            <TableColumn fx:id="colEEstado" text="Estado"     prefWidth="100"/>
                        </columns>
                        <placeholder><Label text="No hay eventos registrados"/></placeholder>
                    </TableView>
                </VBox>
            </Tab>

            <!-- TAB: MÉTRICAS -->
            <Tab text="📊  Métricas">
                <VBox spacing="16">
                    <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                    <Label text="Métricas de Ventas y Ocupación" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1565c0;"/>
                    <HBox spacing="14">
                        <BarChart fx:id="chartVentas" title="Ventas por Evento" HBox.hgrow="ALWAYS">
                            <xAxis><CategoryAxis label="Evento"/></xAxis>
                            <yAxis><NumberAxis label="Ingresos ($)"/></yAxis>
                        </BarChart>
                        <PieChart fx:id="chartOcupacion" title="Ocupación por Zona" prefWidth="280"/>
                    </HBox>
                </VBox>
            </Tab>

            <!-- TAB: REPORTES -->
            <Tab text="📄  Reportes">
                <VBox spacing="20" alignment="CENTER">
                    <padding><Insets top="40" right="60" bottom="40" left="60"/></padding>
                    <Label text="Generación de Reportes" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1565c0;"/>
                    <Button text="📊  Generar Reporte CSV" onAction="#generarReporteCSV" maxWidth="Infinity"
                            style="-fx-background-color: #43a047; -fx-text-fill: white; -fx-font-size: 15px;
                                   -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12 0 12 0; -fx-cursor: hand;"/>
                    <Button text="📑  Generar Reporte PDF" onAction="#generarReportePDF" maxWidth="Infinity"
                            style="-fx-background-color: #1e88e5; -fx-text-fill: white; -fx-font-size: 15px;
                                   -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12 0 12 0; -fx-cursor: hand;"/>
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
