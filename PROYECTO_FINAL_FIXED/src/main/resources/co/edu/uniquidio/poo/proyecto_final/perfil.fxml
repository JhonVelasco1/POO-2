<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.uniquidio.poo.proyecto_final.ViewController.PerfilViewController"
      alignment="TOP_CENTER" spacing="16"
      style="-fx-background-color: #eceff1;">
    <padding><Insets top="30" right="60" bottom="30" left="60"/></padding>

    <Label text="👤  Mi Perfil" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1565c0;"/>

    <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 24;">
        <VBox spacing="5">
            <Label text="Nombre completo" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
            <TextField fx:id="txtNombre" promptText="Tu nombre completo"
                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd; -fx-padding: 8 12 8 12;"/>
        </VBox>
        <VBox spacing="5">
            <Label text="Correo electrónico" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
            <TextField fx:id="txtCorreo" promptText="tu@correo.com"
                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd; -fx-padding: 8 12 8 12;"/>
        </VBox>
        <VBox spacing="5">
            <Label text="Teléfono" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
            <TextField fx:id="txtTelefono" promptText="Número de teléfono"
                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd; -fx-padding: 8 12 8 12;"/>
        </VBox>

        <Button text="💾  Guardar Cambios" onAction="#guardarCambios" maxWidth="Infinity"
                style="-fx-background-color: #1e88e5; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 0 10 0; -fx-cursor: hand;"/>

        <Label fx:id="lblMensaje" style="-fx-text-fill: #2e7d32; -fx-font-size: 13px;"/>
    </VBox>
</VBox>
