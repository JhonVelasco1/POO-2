<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="co.edu.uniquidio.poo.proyecto_final.ViewController.RegistroViewController"
           style="-fx-background-color: linear-gradient(to bottom right, #1a237e, #283593);">

    <VBox alignment="CENTER" spacing="0" maxWidth="420"
          style="-fx-background-color: white; -fx-background-radius: 16;
                 -fx-effect: dropshadow(three-pass-box,rgba(0,0,0,0.3),20,0,0,8);">

        <!-- Header -->
        <VBox alignment="CENTER" spacing="6"
              style="-fx-background-color: #1565c0; -fx-background-radius: 16 16 0 0;">
            <padding><Insets top="24" right="30" bottom="20" left="30"/></padding>
            <Label text="🎟️" style="-fx-font-size: 32px;"/>
            <Label text="Crear Cuenta Nueva"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Regístrate y descubre los mejores eventos"
                   style="-fx-font-size: 12px; -fx-text-fill: #bbdefb;"/>
        </VBox>

        <!-- Formulario -->
        <VBox alignment="CENTER" spacing="11">
            <padding><Insets top="24" right="36" bottom="16" left="36"/></padding>

            <VBox spacing="4">
                <Label text="Nombre completo"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                <TextField fx:id="txtNombre" promptText="Tu nombre completo"
                           style="-fx-font-size: 13px; -fx-background-radius: 8;
                                  -fx-border-radius: 8; -fx-border-color: #ddd; -fx-padding: 7 12 7 12;"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Correo electrónico"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                <TextField fx:id="txtCorreo" promptText="tu@correo.com"
                           style="-fx-font-size: 13px; -fx-background-radius: 8;
                                  -fx-border-radius: 8; -fx-border-color: #ddd; -fx-padding: 7 12 7 12;"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Teléfono"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                <TextField fx:id="txtTelefono" promptText="3001234567"
                           style="-fx-font-size: 13px; -fx-background-radius: 8;
                                  -fx-border-radius: 8; -fx-border-color: #ddd; -fx-padding: 7 12 7 12;"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Contraseña"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                <PasswordField fx:id="txtPassword" promptText="Mínimo 4 caracteres"
                               style="-fx-font-size: 13px; -fx-background-radius: 8;
                                      -fx-border-radius: 8; -fx-border-color: #ddd; -fx-padding: 7 12 7 12;"/>
                <ProgressBar fx:id="progressBar" maxWidth="Infinity" prefHeight="6"
                             style="-fx-background-radius: 4;"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Confirmar contraseña"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                <PasswordField fx:id="txtConfirmarPassword" promptText="Repite tu contraseña"
                               style="-fx-font-size: 13px; -fx-background-radius: 8;
                                      -fx-border-radius: 8; -fx-border-color: #ddd; -fx-padding: 7 12 7 12;"/>
            </VBox>

            <Label fx:id="lblMensaje" wrapText="true" maxWidth="340"
                   style="-fx-font-size: 12px;" alignment="CENTER"/>

            <Button text="Crear Cuenta" onAction="#handleRegistro" maxWidth="Infinity"
                    style="-fx-background-color: #1565c0; -fx-text-fill: white;
                           -fx-font-size: 14px; -fx-font-weight: bold;
                           -fx-background-radius: 8; -fx-padding: 10 0 10 0; -fx-cursor: hand;"/>
        </VBox>

        <!-- Volver al login -->
        <VBox alignment="CENTER" spacing="8">
            <padding><Insets top="4" right="36" bottom="24" left="36"/></padding>
            <Separator/>
            <HBox alignment="CENTER" spacing="6">
                <Label text="¿Ya tienes cuenta?" style="-fx-font-size: 13px; -fx-text-fill: #666;"/>
                <Button text="Inicia sesión" onAction="#irALogin"
                        style="-fx-background-color: transparent; -fx-text-fill: #1565c0;
                               -fx-font-size: 13px; -fx-cursor: hand;
                               -fx-underline: true; -fx-padding: 0;"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>
